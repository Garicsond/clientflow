# Local Postgres (Docker or a local server). Both URLs can be the same locally.
# On Neon, DATABASE_URL is the pooled (-pooler) connection; DATABASE_URL_UNPOOLED is the direct one.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clientflow?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/clientflow?schema=public"

# Shared password for the production site gate. Leave empty to skip locally.
SITE_PASSWORD=""

# Set to "true" to insert sample clients/templates into an empty database
# (required for hosted/production databases). Leave unset for local Postgres.
ALLOW_SEED=""
